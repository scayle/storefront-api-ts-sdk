{
  "compilerOptions": {
    "baseUrl": ".",
    "lib": ["ES2022", "dom", "dom.iterable", "scripthost"],
    "noEmit": true,
    "module": "commonjs",
    "target": "es2018",
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "jsx": "react",
    "noImplicitAny": true,
    "types": ["node", "vitest/globals"],
    "strict": true,
    "erasableSyntaxOnly": true,
    "isolatedDeclarations": true,
    "noCheck": true
  },
  "include": ["src/**/*.ts", "@types/*.d.ts"],
  "exclude": ["node_modules", "src/**/*.test.ts", "dist", "./*.d.ts"]
}
