{
  "name": "@scayle/storefront-api",
  "version": "18.3.1",
  "description": "TypeScript and JavaScript SDK source for the SCAYLE Storefront API",
  "author": "SCAYLE Commerce Engine",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./test/factories": {
      "import": {
        "types": "./dist/test/factories/index.d.mts",
        "default": "./dist/test/factories/index.mjs"
      },
      "require": {
        "types": "./dist/test/factories/index.d.cts",
        "default": "./dist/test/factories/index.cjs"
      },
      "default": {
        "types": "./dist/test/factories/index.d.cts",
        "default": "./dist/test/factories/index.cjs"
      }
    },
    "./dist/test/factories": {
      "import": {
        "types": "./dist/test/factories/index.d.mts",
        "default": "./dist/test/factories/index.mjs"
      },
      "require": {
        "types": "./dist/test/factories/index.d.cts",
        "default": "./dist/test/factories/index.cjs"
      },
      "default": {
        "types": "./dist/test/factories/index.d.cts",
        "default": "./dist/test/factories/index.cjs"
      }
    }
  },
  "engines": {
    "node": ">= 18.15.0"
  },
  "peerDependenciesMeta": {
    "fishery": {
      "optional": true
    }
  },
  "peerDependencies": {
    "fishery": "^2.2.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.17.4",
    "@scayle/eslint-config-storefront": "4.5.1",
    "@types/node": "22.15.15",
    "@vitest/coverage-v8": "3.1.3",
    "dprint": "0.49.1",
    "eslint": "9.26.0",
    "eslint-formatter-gitlab": "6.0.0",
    "fishery": "2.3.1",
    "nock": "14.0.4",
    "publint": "0.2.12",
    "rimraf": "6.0.1",
    "typescript": "5.8.3",
    "unbuild": "3.5.0",
    "vitest": "3.1.3"
  },
  "scripts": {
    "clean": "rimraf ./dist",
    "build": "unbuild",
    "verify-packaging": "attw --exclude-entrypoints test/factories --pack . && attw --entrypoints test/factories --profile node16 --pack .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "dprint check",
    "format:fix": "dprint fmt",
    "lint": "eslint .",
    "lint:ci": "eslint . --format gitlab",
    "lint:fix": "eslint . --fix",
    "package:lint": "publint",
    "test:watch": "vitest --passWithNoTests",
    "test": "vitest --run --passWithNoTests",
    "test:ci": "vitest --run --passWithNoTests --coverage --reporter=default --reporter=junit --outputFile=./coverage/junit.xml"
  },
  "dependencies": {
    "utility-types": "3.11.0"
  }
}
