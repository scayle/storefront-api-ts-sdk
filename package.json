{
  "name": "@scayle/storefront-api",
  "version": "17.8.0",
  "description": "TypeScript and JavaScript SDK source for the SCAYLE Storefront API",
  "author": "SCAYLE Commerce Engine",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    }
  },
  "engines": {
    "node": ">= 18.15.0"
  },
  "devDependencies": {
    "@scayle/eslint-config-storefront": "4.3.1",
    "@types/node": "20.16.11",
    "@vitest/coverage-v8": "2.1.3",
    "dprint": "0.47.2",
    "eslint": "9.12.0",
    "eslint-formatter-gitlab": "5.1.0",
    "nock": "13.5.5",
    "publint": "0.2.11",
    "rimraf": "6.0.1",
    "typescript": "5.6.3",
    "unbuild": "2.0.0",
    "vitest": "2.1.3"
  },
  "scripts": {
    "clean": "rimraf ./dist",
    "build": "unbuild",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "dprint check",
    "format:fix": "dprint fmt",
    "lint": "eslint . --format gitlab",
    "lint:fix": "eslint . --fix",
    "package:lint": "publint",
    "test:watch": "vitest --passWithNoTests",
    "test": "vitest --run --passWithNoTests",
    "test:ci": "vitest --run --passWithNoTests --coverage --reporter=default --reporter=junit"
  }
}
